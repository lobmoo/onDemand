    {
      "id": "file:thirdparty/CRoaring/include/cmocka.h",
      "type": "file",
      "name": "cmocka.h",
      "filePath": "thirdparty/CRoaring/include/cmocka.h",
      "summary": "cmocka 单元测试框架的核心头文件，提供测试用例定义、断言宏、mock 函数和测试运行器等完整的 C 语言单元测试基础设施。",
      "tags": ["third-party", "testing", "unit-test-framework", "mock"],
      "complexity": "complex",
      "languageNotes": "包含 CMUnitTest 结构体和大量测试断言宏（assert_int_equal、assert_string_equal 等），是 CRoaring 项目测试子系统的依赖。"
    },
    {
      "id": "file:thirdparty/CRoaring/include/roaring/array_util.h",
      "type": "file",
      "name": "array_util.h",
      "filePath": "thirdparty/CRoaring/include/roaring/array_util.h",
      "summary": "有序 uint16 数组的工具函数集，提供二分查找（binarySearch）、区间计数（count_less/count_greater）、数组合并/交集/差集等高效操作，是 Roaring Bitmap 数组容器的核心算法基础。",
      "tags": ["third-party", "utility", "algorithm", "binary-search", "array-operations"],
      "complexity": "moderate",
      "languageNotes": "所有函数均为 static inline，支持 C/C++ 双模式编译，使用 roaring::internal 命名空间。"
    },
    {
      "id": "file:thirdparty/CRoaring/include/roaring/art/art.h",
      "type": "file",
      "name": "art.h",
      "filePath": "thirdparty/CRoaring/include/roaring/art/art.h",
      "summary": "自适应基数树（Adaptive Radix Tree, ART）实现的头文件，采用固定 48 位键长度、键压缩和无指针设计（通过索引引用节点），支持高效的前缀查找和有序遍历。",
      "tags": ["third-party", "data-structure", "radix-tree", "indexing"],
      "complexity": "moderate",
      "languageNotes": "基于 Leis et al. 论文《The Adaptive Radix Tree》实现，节点通过 art_ref_t（类型码 + 数组索引）而非指针引用，支持零拷贝反序列化。"
    },
    {
      "id": "file:thirdparty/CRoaring/include/roaring/bitset_util.h",
      "type": "file",
      "name": "bitset_util.h",
      "filePath": "thirdparty/CRoaring/include/roaring/bitset_util.h",
      "summary": "底层位集合（bitset）操作工具集，提供范围设置/翻转/重置、基数计算和 Harley-Seal popcount 等 SIMD 优化的位操作函数，是 bitset 容器的性能核心。",
      "tags": ["third-party", "utility", "bitset", "simd", "popcount", "performance"],
      "complexity": "complex",
      "languageNotes": "包含 AVX2 优化的 Harley-Seal popcount 实现（popcount256、avx2_harley_seal_popcount256），使用 CSA（Carry-Save Adder）技术加速位计数。"
    },
    {
      "id": "file:thirdparty/CRoaring/include/roaring/bitset/bitset.h",
      "type": "file",
      "name": "bitset.h",
      "filePath": "thirdparty/CRoaring/include/roaring/bitset/bitset.h",
      "summary": "独立的位集合（bitset）库头文件，提供完整的 bitset 数据结构和操作接口，包括创建、销毁、集合运算、序列化等功能。",
      "tags": ["third-party", "data-structure", "bitset", "container"],
      "complexity": "moderate"
    },
    {
      "id": "file:thirdparty/CRoaring/include/roaring/containers/array.h",
      "type": "file",
      "name": "array.h",
      "filePath": "thirdparty/CRoaring/include/roaring/containers/array.h",
      "summary": "Roaring Bitmap 的数组容器实现，使用有序 uint16 数组存储稀疏位集合，适用于元素数量较少的区间，提供插入、查找、集合运算等完整操作。",
      "tags": ["third-party", "data-structure", "container", "array", "roaring"],
      "complexity": "moderate",
      "languageNotes": "array_container_t 结构体包含 cardinality、capacity 和 uint16_t* 数组，当元素超过 ARRAY_LAZY_LOWERBOUND（1024）时可自动转换为 bitset 容器。"
    },
    {
      "id": "file:thirdparty/CRoaring/include/roaring/containers/bitset.h",
      "type": "file",
      "name": "bitset.h",
      "filePath": "thirdparty/CRoaring/include/roaring/containers/bitset.h",
      "summary": "Roaring Bitmap 的位集合容器实现，使用固定大小的 uint64 位图存储密集位集合，适用于元素数量较多的区间，提供位操作和 SIMD 加速的基数计算。",
      "tags": ["third-party", "data-structure", "container", "bitset", "roaring"],
      "complexity": "moderate"
    },
    {
      "id": "file:thirdparty/CRoaring/include/roaring/containers/container_defs.h",
      "type": "file",
      "name": "container_defs.h",
      "filePath": "thirdparty/CRoaring/include/roaring/containers/container_defs.h",
      "summary": "容器类型基础定义头文件，定义 container_t 基类、STRUCT_CONTAINER 宏和类型安全的 CAST/movable_CAST 转换宏，是所有容器类型的公共基础设施。",
      "tags": ["third-party", "type-definition", "container", "macros", "base-class"],
      "complexity": "simple",
      "languageNotes": "使用 C++ 模板实现 movable_CAST_HELPER 的编译期类型安全检查（std::is_base_of），C 模式下退化为普通类型转换。"
    },
    {
      "id": "file:thirdparty/CRoaring/include/roaring/containers/containers.h",
      "type": "file",
      "name": "containers.h",
      "filePath": "thirdparty/CRoaring/include/roaring/containers/containers.h",
      "summary": "容器子系统的核心聚合头文件，汇总所有容器类型（array、bitset、run）及其混合运算（intersection、union、andnot、xor、negation、subset、equal），定义容器类型码和 PAIR_CONTAINER_TYPES 宏用于双类型 switch 分派。",
      "tags": ["third-party", "aggregation-header", "container", "dispatcher", "roaring"],
      "complexity": "complex",
      "languageNotes": "定义 BITSET_CONTAINER_TYPE=1、ARRAY_CONTAINER_TYPE=2、RUN_CONTAINER_TYPE=3、SHARED_CONTAINER_TYPE=4，通过 PAIR_CONTAINER_TYPES 宏实现 O(1) 的双容器类型分派。"
    },
