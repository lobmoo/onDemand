  "nodes": [
    {
      "id": "file:sample/data_memory_manger/concurrentqueue.h",
      "type": "file",
      "name": "concurrentqueue.h",
      "filePath": "sample/data_memory_manger/concurrentqueue.h",
      "summary": "moodycamel::ConcurrentQueue 第三方高性能无锁队列库的头文件实现，支持多生产者多消费者（MPMC）并发访问，采用分层块索引和无锁原子操作实现高吞吐量。",
      "tags": ["third-party", "lock-free", "concurrent-data-structure", "header-only"],
      "complexity": "complex",
      "languageNotes": "4247行的大型 header-only 库，使用 C++11 原子操作和内存序实现无锁队列，支持 ExplicitProducer（显式令牌）和 ImplicitProducer（隐式哈希映射）两种生产者模式。"
    },
    {
      "id": "file:sample/data_memory_manger/variable_store.h",
      "type": "file",
      "name": "variable_store.h",
      "filePath": "sample/data_memory_manger/variable_store.h",
      "summary": "基于 Seqlock 的无锁变量存储实现，提供变量注册、读写、脏数据追踪功能。使用 64 字节对齐的 arena 内存布局和 ConcurrentQueue 脏队列，支持零拷贝读取和批量脏数据分发。",
      "tags": ["lock-free", "data-model", "concurrent-data-structure", "seqlock"],
      "complexity": "moderate",
      "languageNotes": "采用 Seqlock 模式（atomic seq 奇数=写入中，偶数=稳定），结合 ConcurrentQueue 实现脏变量追踪，ScopedPtr 提供 RAII 式零拷贝读取。"
    },
    {
