    {
      "id": "file:common/timer_wheel/timer_wheel.h",
      "type": "file",
      "name": "timer_wheel.h",
      "filePath": "common/timer_wheel/timer_wheel.h",
      "summary": "8 层分层时间轮实现，源自 Juho Snellman 的 MIT 开源项目。支持 256 个 slot/层，1 tick 精度，适用于 1ms 到数天范围的定时器。提供事件调度（schedule）、范围调度（schedule_in_range）、推进（advance）和取消（cancel）接口。",
      "tags": ["utility", "timer", "data-structure", "header-only", "hierarchical-timer-wheel"],
      "complexity": "complex",
      "languageNotes": "8 层分层时间轮，每层 256 个 slot（WIDTH_BITS=8），支持 64 位 tick 范围。内层轮处理近期事件，外层轮存放远期事件，每次内层轮满一圈时从外层轮提升事件。使用侵入式双向链表管理事件，避免额外内存分配。"
    },
    {
      "id": "class:common/timer_wheel/timer_wheel.h:TimerWheel",
      "type": "class",
      "name": "TimerWheel",
      "filePath": "common/timer_wheel/timer_wheel.h",
      "lineRange": [219, 301],
      "summary": "分层时间轮核心类，管理多层 slot 数组和当前时间戳。提供 schedule、schedule_in_range、advance、ticks_to_next_event 等接口，支持高效的定时事件调度和推进。",
      "tags": ["timer", "data-structure", "hierarchical-wheel"],
      "complexity": "complex"
    },
    {
