  "nodes": [
    {
      "id": "file:common/timer_wheel/thread_pool.h",
      "type": "file",
      "name": "thread_pool.h",
      "filePath": "common/timer_wheel/thread_pool.h",
      "summary": "基于条件变量的固定大小线程池实现，支持带返回值的任务入队（enqueue）和轻量无返回值入队（enqueue_void），内部使用 std::queue + std::mutex 保护任务队列。",
      "tags": ["utility", "concurrency", "thread-pool", "header-only"],
      "complexity": "moderate",
      "languageNotes": "头文件内联实现全部成员函数，模板方法 enqueue 使用 std::packaged_task 支持返回 std::future；enqueue_void 避免 packaged_task 的额外堆分配以提升性能。"
    },
    {
      "id": "class:common/timer_wheel/thread_pool.h:ThreadPool",
      "type": "class",
      "name": "ThreadPool",
      "filePath": "common/timer_wheel/thread_pool.h",
      "lineRange": [29, 49],
      "summary": "固定大小线程池，构造时启动指定数量的工作线程，每个线程从共享任务队列中取任务执行。析构时通知所有线程停止并 join。",
      "tags": ["concurrency", "thread-pool", "utility"],
      "complexity": "moderate"
    },
    {
      "id": "function:common/timer_wheel/thread_pool.h:enqueue",
      "type": "function",
      "name": "enqueue",
      "filePath": "common/timer_wheel/thread_pool.h",
      "lineRange": [86, 106],
      "summary": "模板方法，将可调用对象及其参数封装为 packaged_task 入队，返回 std::future 以便调用者获取异步结果。线程池已停止时抛出 runtime_error。",
      "tags": ["concurrency", "async", "template"],
      "complexity": "moderate"
    },
    {
      "id": "file:common/timer_wheel/timer_scheduler.h",
      "type": "file",
      "name": "timer_scheduler.h",
      "filePath": "common/timer_wheel/timer_scheduler.h",
      "summary": "高层定时器调度器，封装 TimerWheel 和 ThreadPool，提供一次性定时（Schedule）、周期性定时（ScheduleRecurring）、取消、暂停/恢复、Post 即时任务等功能。被发布端和订阅端用于管理定时发布与回调任务。",
      "tags": ["service", "timer", "scheduler", "concurrency", "header-only"],
      "complexity": "complex",
      "languageNotes": "内部定义 CallbackTimer 和 RecurringCallbackTimer 两个定时事件类，继承自 TimerWheel 的 TimerEventInterface。调度器运行独立的 TimerLoop 线程，按 tick_ms 间隔推进 TimerWheel 并将到期回调派发到 ThreadPool 执行。"
    },
    {
      "id": "class:common/timer_wheel/timer_scheduler.h:TimerScheduler",
      "type": "class",
      "name": "TimerScheduler",
